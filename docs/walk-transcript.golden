  observation recorded: samples 2 → 3
  frame annotation before: personalemail.search = (q: string) -> { ids: [string] } ~survival(exp, OBSERVED)
  frame annotation after:  personalemail.search = (q: string) -> { ids: [string] } ~survival(exp, OBSERVED)
